DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
JWT_SECRET=change-me-to-a-random-64-char-hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me
ADMIN_NAME=Site Admin
S3_ENDPOINT=https://s3.filebase.io
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=your-bucket
CORS_ORIGINS=*

# Public CDN base for the R2 bucket (r2.dev public access). Empty = serve
# everything through the authenticated /api/media proxy instead.
R2_PUBLIC_BASE_URL=
